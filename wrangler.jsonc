{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "library-thecarmacks-com",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "library-db",
      "database_id": "191f07d7-81a4-4b2c-a638-5bbad7539964",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "COVERS",
      "bucket_name": "library-covers"
    },
    {
      "binding": "BACKUPS",
      "bucket_name": "library-backups"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Sundays at 06:00 UTC — low-traffic time, well clear of any weekday usage.
    "crons": ["0 6 * * 7"]
  }
}
